{
  "name": "vpm-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-i18n.mjs && vite build && node scripts/copy-template.mjs",
    "preview": "vite preview",
    "check:template": "node scripts/check-template.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "upgrade": "node -e \"require('fs').rmSync('package-lock.json',{force:true})\" && npx npm-check-updates -u"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19",
    "react-dom": "^19",
    "styled-components": "^6.7.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "sass": "^1.108.2",
    "typescript": "^7",
    "vite": "^8.3.7",
    "vite-plugin-svgr": "^5.2.0"
  }
}
